```cshtml
@model IEnumerable<StudentAccountmvc.Models.Result>

@{
    ViewData["Title"] = "Results";
}

<div class="container-fluid mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                📊 Examination Results
            </h2>

            <p class="text-muted mb-0">
                View and manage your subject-wise examination results.
            </p>
        </div>

        <div>
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-secondary">
                Dashboard
            </a>

            <a asp-action="Create"
               class="btn btn-primary">
                + Add Result
            </a>
        </div>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- RESULT CARD -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center p-5">

                    <div class="fs-1">
                        📊
                    </div>

                    <h5 class="mt-3">
                        No Results Found
                    </h5>

                    <p class="text-muted">
                        No examination result has been added yet.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        + Add First Result
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover table-bordered align-middle">

                        <thead class="table-primary">

                            <tr>
                                <th>#</th>
                                <th>Subject</th>
                                <th>Marks</th>
                                <th>Maximum Marks</th>
                                <th>Percentage</th>
                                <th>Grade</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int count = 1;
                            }

                            @foreach (var result in Model)
                            {
                                double percentage = 0;

                                if (result.MaxMarks > 0)
                                {
                                    percentage =
                                        ((double)result.Marks / result.MaxMarks) * 100;
                                }

                                <tr>

                                    <td>
                                        @count
                                    </td>

                                    <td>
                                        <strong>
                                            @result.Subject
                                        </strong>
                                    </td>

                                    <td>
                                        @result.Marks
                                    </td>

                                    <td>
                                        @result.MaxMarks
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @percentage.ToString("0.00")%
                                        </span>
                                    </td>

                                    <td>

                                        @if (!string.IsNullOrEmpty(result.Grade))
                                        {
                                            <span class="badge bg-success">
                                                @result.Grade
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                N/A
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <a asp-action="Edit"
                                           asp-route-id="@result.Id"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@result.Id"
                                              method="post"
                                              class="d-inline">

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Are you sure you want to delete this result?');">
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                                count++;
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>
```
