@model IEnumerable<StudentAccountmvc.Models.Fees>

@{
    ViewData["Title"] = "Fees";
}

<style>
    .print-header {
        display: none;
    }

    @@media print {
        body {
            background: white !important;
        }

        .no-print {
            display: none !important;
        }

        .print-header {
            display: block !important;
            text-align: center;
            margin-bottom: 25px;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        .table {
            width: 100%;
            border: 1px solid #000;
        }

            .table th,
            .table td {
                border: 1px solid #000 !important;
            }
    }
</style>

<div class="container-fluid mt-4">

    <div class="print-header">
        <h2>Student Fees Report</h2>
        <p>Fees Payment Details</p>
        <hr />
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 no-print">

        <div>
            <h2>Fees</h2>
            <p class="text-muted">
                Manage your fee payment details
            </p>
        </div>

        <div>
            <a asp-action="Create"
               class="btn btn-success me-2">
                + Add Fees
            </a>

            <button type="button"
                    onclick="window.print()"
                    class="btn btn-dark me-2">
                🖨 Print
            </button>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-primary">
                Back to Dashboard
            </a>
        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success no-print">
            @TempData["Success"]
        </div>
    }

    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Total Fees</h6>
                    <h3>
                        ₹@Model.Sum(x => x.TotalAmount).ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Paid</h6>
                    <h3 class="text-success">
                        ₹@Model.Sum(x => x.PaidAmount).ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Pending</h6>
                    <h3 class="text-danger">
                        ₹@Model.Sum(x => x.PendingAmount).ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    No fee record available.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-primary">

                            <tr>
                                <th>#</th>
                                <th>Fee Type</th>
                                <th>Total Amount</th>
                                <th>Paid Amount</th>
                                <th>Pending Amount</th>
                                <th>Status</th>
                                <th class="no-print">Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int count = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>@count</td>

                                    <td>
                                        <strong>
                                            @item.FeeType
                                        </strong>
                                    </td>

                                    <td>
                                        ₹@item.TotalAmount.ToString("N2")
                                    </td>

                                    <td class="text-success">
                                        ₹@item.PaidAmount.ToString("N2")
                                    </td>

                                    <td class="text-danger">
                                        ₹@item.PendingAmount.ToString("N2")
                                    </td>

                                    <td>

                                        @if (item.Status == "Paid")
                                        {
                                            <span class="badge bg-success">
                                                Paid
                                            </span>
                                        }
                                        else if (item.Status == "Partial")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Partial
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Pending
                                            </span>
                                        }

                                    </td>

                                    <td class="no-print">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Are you sure you want to delete this fee record?');">
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                                count++;
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>
