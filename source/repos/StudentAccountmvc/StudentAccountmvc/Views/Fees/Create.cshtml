
@model StudentAccountmvc.Models.Fees

@{
    ViewData["Title"] = "Add Fees";
}

<div class="container mt-4">

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Add Fees</h4>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FeeType" class="form-label">
                        Fee Type
                    </label>

                    <input asp-for="FeeType"
                           class="form-control"
                           placeholder="e.g. Tuition Fee" />

                    <span asp-validation-for="FeeType"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TotalAmount" class="form-label">
                        Total Amount
                    </label>

                    <input asp-for="TotalAmount"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           placeholder="Enter total amount" />

                    <span asp-validation-for="TotalAmount"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PaidAmount" class="form-label">
                        Paid Amount
                    </label>

                    <input asp-for="PaidAmount"
                           type="number"
                           step="0.01"
                           min="0"
                           value="0"
                           class="form-control"
                           placeholder="Enter paid amount" />

                    <span asp-validation-for="PaidAmount"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Add Fees
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

