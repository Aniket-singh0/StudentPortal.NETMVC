@model StudentAccountmvc.Models.Assignment

@{
    ViewData["Title"] = "Add Assignment";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h4>Add Assignment</h4>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div class="mb-3">

                    <label class="form-label">
                        Assignment Title
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Enter assignment title" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Subject
                    </label>

                    <input asp-for="Subject"
                           class="form-control"
                           placeholder="Enter subject" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Due Date
                    </label>

                    <input asp-for="DueDate"
                           type="date"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Status
                    </label>

                    <select asp-for="Status"
                            class="form-select">

                        <option value="Pending">
                            Pending
                        </option>

                        <option value="Completed">
                            Completed
                        </option>

                    </select>

                </div>

                <button class="btn btn-success">
                    Add Assignment
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>