
@model IEnumerable<StudentAccountmvc.Models.Attendance>

@{
    ViewData["Title"] = "Attendance";
}

<style>

    .print-header {
        display: none;
    }

    @@media print {

        body {
            background: white !important;
        }

        .no-print {
            display: none !important;
        }

        .print-header {
            display: block !important;
            text-align: center;
            margin-bottom: 25px;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        .table {
            width: 100%;
            border: 1px solid #000;
        }

            .table th,
            .table td {
                border: 1px solid #000 !important;
            }

        .container-fluid {
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }
    }

</style>

<div class="container-fluid mt-4">

    <div class="print-header">

        <h2>Student Attendance Report</h2>

        <p>
            Subject-wise Attendance Record
        </p>

        <hr />

    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 no-print">

        <div>
            <h2>Attendance</h2>

            <p class="text-muted">
                Subject-wise attendance record
            </p>
        </div>

        <div>

            <a asp-controller="Attendance"
               asp-action="Create"
               class="btn btn-success me-2">
                + Add Attendance
            </a>

            <button type="button"
                    onclick="window.print()"
                    class="btn btn-dark me-2">
                🖨 Print
            </button>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-primary">
                Back to Dashboard
            </a>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success no-print">
            @TempData["Success"]
        </div>
    }

    <div class="card shadow">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    No attendance record available.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-primary">

                            <tr>

                                <th>#</th>

                                <th>Subject</th>

                                <th>Total Classes</th>

                                <th>Present</th>

                                <th>Absent</th>

                                <th>Attendance %</th>

                                <th>Status</th>

                                <th class="no-print">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int count = 1;
                            }

                            @foreach (var item in Model)
                            {
                                int total = item.TotalClasses ?? 0;

                                int present = item.PresentClasses ?? 0;

                                int absent = total - present;

                                double percentage = total > 0
                                    ? ((double)present / total) * 100
                                    : 0;

                                <tr>

                                    <td>
                                        @count
                                    </td>

                                    <td>
                                        <strong>
                                            @item.Subject
                                        </strong>
                                    </td>

                                    <td>
                                        @total
                                    </td>

                                    <td>
                                        @present
                                    </td>

                                    <td>
                                        @absent
                                    </td>

                                    <td>
                                        @percentage.ToString("0.00")%
                                    </td>

                                    <td>

                                        @if (percentage >= 75)
                                        {
                                            <span class="badge bg-success">
                                                Good
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Low
                                            </span>
                                        }

                                    </td>

                                    <td class="no-print">

                                        <a asp-controller="Attendance"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <form asp-controller="Attendance"
                                              asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Are you sure you want to delete this attendance?');">
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                                count++;
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>

